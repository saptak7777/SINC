// ==========================================
// sinc/build.staff
// SINC Compiler Master Build Manifest
// ==========================================

artifact sinc [
    target = linux_x64;
    type   = bin;
]

deps [
    steel/sys/sys.sinc;
    steel/sys/arena.sinc;
    steel/sys/stream.sinc;
    steel/sys/os_linux.sinc;
    steel/data/slice.sinc;
    steel/pure/hash.sinc;
    steel/pure/sym_table.sinc;
    steel/pure/ctype.sinc;
]

driver [
    steel/sys/driver_linux.sinc;
]

flags [
    optimize = 3;
    heap     = 1000000000;
]
