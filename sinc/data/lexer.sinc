// ==========================================
// sinc/data/lexer.sinc
// SINC Compiler: Pure Zero-Table TRG Lexer & SWAR Engine
// ==========================================

// Constant Lenses for Lexer State (6 words)
const LEX_SRC_PTR = 0;
const LEX_SRC_LEN = 1;
const LEX_CURSOR  = 2;
const LEX_TMP_PTR = 4;
const LEX_TMP_LEN = 5;

// Constant Lenses for Token Output (4 words)
const TOK_TYPE  = 0;
const TOK_VAL   = 1;
const TOK_FLAGS = 3;

// Token Metadata Flags (Stored in TOK_FLAGS)
const FLAG_LINEAR = 1;
const FLAG_PURE   = 2;

// Single-Source Iterative TRG Lexer Engine (Zero-Table)
fn lexer_next_token!(state, sym_table, sym_capacity, sym_count, out_token) [
    src_ptr   = state.LEX_SRC_PTR;
    src_len   = state.LEX_SRC_LEN;
    cursor    = state.LEX_CURSOR;
    tok_type  = 0;
    tok_val   = 0;
    tok_flags = 0;

    // 1. Skip Whitespace (240..242) & Comments (115/115 and 115/114)
    loop (step:10000000 = 0 .. (src_len + 1)) [
        if (!(cursor < src_len)) [
            step = src_len + 1;
        ] else [
            ch = src_ptr@[cursor * 1];
            if ((ch > 239) & (ch < 243)) [
                ptr = src_ptr + cursor;
                if (ptr@[0] == -1085102592571150096) [
                    cursor = cursor + 8;
                ] else [
                    cursor = cursor + 1;
                ]
            ] else [
                if (ch == 115) [
                    nch = src_ptr@[(cursor + 1) * 1];
                    if ((nch == 115) | (nch == 114)) [
                        cursor = cursor + 2;
                        loop (ck:10000000 = cursor .. src_len) [
                            c_ch = src_ptr@[cursor * 1];
                            cursor = cursor + 1;
                            if ((nch == 115) & (c_ch == 241)) [
                                ck = src_len;
                            ]
                            if ((nch == 114) & (c_ch == 114)) [
                                if (src_ptr@[cursor * 1] == 115) [
                                    cursor = cursor + 1;
                                    ck = src_len;
                                ]
                            ]
                        ]
                    ] else [
                        step = src_len + 1;
                    ]
                ] else [
                    step = src_len + 1;
                ]
            ]
        ]
    ]

    if (cursor < src_len) [
        ch = src_ptr@[cursor * 1];

        // 2. Digit Literal: 52..61 (0x34..0x3D)
        is_digit = !(ch < 52) & !(ch > 61);
        if (is_digit) [
            tok_type = 10;
            loop (k:10000000 = cursor .. src_len) [
                d_ch = src_ptr@[cursor * 1];
                if ((d_ch < 52) | (d_ch > 61)) [
                    k = src_len;
                ] else [
                    tok_val = (tok_val * 10) + (d_ch - 52);
                    cursor = cursor + 1;
                ]
            ]
        ]

        // 3. Identifier or Keyword (Canonical TRG Aperture: Bank A, Bank B, or Underscore 243)
        is_lang = (ch & 112) != 112;
        is_ident_start = (is_lang & !is_digit) | (ch == 243);
        if ((tok_type == 0) & is_ident_start) [
            start_cursor = cursor;
            cursor = cursor + 1;
            loop (k:10000000 = cursor .. src_len) [
                i_ch = src_ptr@[cursor * 1];
                is_sym = (i_ch == 243) | (i_ch == 120) | (i_ch == 124);
                is_cont = ((i_ch & 112) != 112) | is_sym;
                if (!is_cont) [
                    k = src_len;
                ] else [
                    cursor = cursor + 1;
                ]
            ]
            ptr = src_ptr + start_cursor;
            len = cursor - start_cursor;
            tok_flags = FLAG_PURE | FLAG_LINEAR;

            if (ptr@[(len - 1) * 1] == 124) [
                tok_flags = tok_flags & -2;
                len = len - 1;
            ]
            if (ptr@[(len - 1) * 1] == 120) [
                tok_flags = tok_flags & -3;
                len = len - 1;
            ]

            // 3.1. Flattened SWAR 1-Load Keyword Matching (Rule 15 Compliant)
            if (len < 7) [
                kw = ptr@[0] & ((1 << (len << 3)) - 1);
                if ((len == 2) & (kw == 10015)) [
                    tok_type = 1;
                ]
                if ((len == 2) & (kw == 7970)) [
                    tok_type = 5;
                ]
                if ((len == 3) & (kw == 2956843)) [
                    tok_type = 3;
                ]
                if ((len == 4) & (kw == 690497573)) [
                    tok_type = 6;
                ]
                if ((len == 4) & (kw == 506209566)) [
                    tok_type = 7;
                ]
                if ((len == 5) & (kw == 194014291996)) [
                    tok_type = 4;
                ]
                if ((len == 6) & (kw == 43066143355166)) [
                    tok_type = 8;
                ]
            ]

            if (tok_type == 0) [
                state.LEX_TMP_PTR = ptr;
                state.LEX_TMP_LEN = len;
                tmp_slice = state + 32;
                hash = hash_fnv1a(tmp_slice);
                sym_id = sym_intern!(sym_table, sym_capacity, tmp_slice, hash, sym_count);
                tok_type = 9;
                tok_val = sym_id;
            ]
        ]

        // 4. Delimiters (244..253) & Operators (112..127) via Direct TRG Byte Token IDs
        if (tok_type == 0) [
            tok_type = ch;
            cursor = cursor + 1;
            if (((ch > 116) & (ch < 121)) | (ch == 253)) [
                nch = src_ptr@[cursor * 1];
                if ((ch == nch) & (ch < 120)) [
                    tok_type = ch + 12;
                    cursor = cursor + 1;
                ]
                if ((ch == 120) & (nch == 117)) [
                    tok_type = 132;
                    cursor = cursor + 1;
                ]
                if ((ch == 253) & (nch == 253)) [
                    tok_type = 128;
                    cursor = cursor + 1;
                ]
            ]
        ]
    ]

    // 5. Single Source of Truth Token Epilogue
    state.LEX_CURSOR    = cursor;
    out_token.TOK_TYPE  = tok_type;
    out_token.TOK_VAL   = tok_val;
    out_token.TOK_FLAGS = tok_flags;
    ret 0;
]
