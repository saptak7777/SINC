// ==========================================
// steel/pure/sym_table.sinc
// S.T.E.E.L. Arena-Backed Symbol Table
// ==========================================

const SYM_HASH = 0; // The 64-bit FNV-1a Hash
const SYM_PTR  = 1; // String character pointer
const SYM_LEN  = 2; // String length
const SYM_VAL  = 3; // Unique integer ID

fn sym_init!(arena, capacity) [
    // 4 words per slot, capacity * 4 total words
    table = arena_alloc_words!(arena, capacity * 4);
    if (table == 0) [
        ret 0;
    ]

    // Set the hash of every slot to 0
    loop (i:10000000 = 0 .. capacity) [
        slot_word = i * 4;
        table@[slot_word] = 0;
    ]

    ret table;
]

fn sym_intern!(table, capacity, slice, hash, count) [
    // 1. Fail-Fast Load Factor Guard (80% full)
    current_count = count@[0];
    limit = (capacity * 8) / 10;
    if (current_count > limit) [
        sys_exit!(3);
    ]

    // 2. Calculate index using bitwise AND mask (capacity must be a power of two)
    idx = hash & (capacity - 1);

    // 3. Probing Loop
    loop (step:10000000 = 0 .. capacity) [
        slot_offset = idx * 32;
        slot_ptr = table + slot_offset;
        slot_hash = slot_ptr.SYM_HASH;

        // Condition A: Empty Slot
        if (slot_hash == 0) [
            slot_ptr.SYM_HASH = hash;
            
            ptr_val = slice.SLICE_PTR;
            len_val = slice.SLICE_LEN;
            slot_ptr.SYM_PTR = ptr_val;
            slot_ptr.SYM_LEN = len_val;

            new_val = current_count + 1;
            count@[0] = new_val;
            slot_ptr.SYM_VAL = new_val;
            ret new_val;
        ]

        // Condition B: Match
        if (slot_hash == hash) [
            // Skip SYM_HASH offset (8 bytes) to cast the rest as a slice pointer
            slot_slice_ptr = slot_ptr + 8;
            is_match = slice_eq(slice, slot_slice_ptr);
            if (is_match == 1) [
                ret slot_ptr.SYM_VAL;
            ]
        ]

        // Condition C: Collision - linear probe to next slot
        idx = (idx + 1) & (capacity - 1);
    ]

    // Table is full (fallback guard)
    sys_exit!(3);
    ret 0;
]
