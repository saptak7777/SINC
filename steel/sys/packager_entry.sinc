// ==========================================
// steel/sys/packager_entry.sinc
// Standalone SINC .safe to Linux ELF Packager CLI
// ==========================================

fn main!(argc, argv_ptr) [
    if (argc < 3) [
        sys_exit!(1);
    ]

    safe_path = argv_ptr@[1];
    elf_path  = argv_ptr@[2];

    raw_mem = sys_mmap!(160000000); // 160MB Arena
    if (raw_mem == -1) [
        sys_exit!(4); // Out of system memory
    ]
    arena = arena_init!(raw_mem, 160000000);
    res = pack_safe_to_elf!(safe_path, elf_path, arena);
    sys_exit!(res);
]
