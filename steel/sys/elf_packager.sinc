// ==========================================
// steel/sys/elf_packager.sinc
// S.T.E.E.L. .safe to Linux x86-64 ELF Packager
// ==========================================

fn emit_thunk3!(thunks, base, sys_nr) [
    thunks@[base]       = 72 | (137 << 8) | (207 << 16) | (72 << 24) | (137 << 32) | (214 << 40) | (72 << 48) | (137 << 56);
    thunks@[(base + 1)] = 218 | (184 << 8) | (sys_nr << 16) | (15 << 48) | (5 << 56);
    thunks@[(base + 2)] = 195;
    ret 0;
]

fn pack_safe_to_elf!(safe_path, elf_path, arena) [
    safe_fd = sys_open_read!(safe_path);
    if (safe_fd < 0) [
        sys_exit!(1);
    ]

    header_buf = arena_alloc_words!(arena, 4);
    header_bytes = sys_read!(safe_fd, header_buf, 32);
    if (header_bytes != 32) [
        sys_close!(safe_fd);
        sys_exit!(2);
    ]

    format = header_buf@[0];
    magic = format & 4294967295;
    version = format >> 32;
    code_len = header_buf@[1];
    main_offset = header_buf@[2];
    if ((magic != 1396786245) | (version != 1) | (header_buf@[3] != 32) | (!(main_offset < code_len))) [
        sys_close!(safe_fd);
        sys_exit!(2);
    ]

    elf_fd = sys_open_write!(elf_path);
    if (elf_fd < 0) [
        sys_close!(safe_fd);
        sys_exit!(3);
    ]

    image_size = 448 + code_len;
    img = arena_alloc_words!(arena, (image_size + 7) >> 3);

    // 1. ELF Header (64 bytes) & Program Header (56 bytes) [Words 0..14]
    img@[0]  = 127 | (69 << 8) | (76 << 16) | (70 << 24) | (2 << 32) | (1 << 40) | (1 << 48);
    img@[1]  = 0;
    img@[2]  = 2 | (62 << 16) | (1 << 32);
    img@[3]  = 4194424; // ELF_ENTRY = 0x400078
    img@[4]  = 64;      // e_phoff = 64
    img@[5]  = 0;
    img@[6]  = 0 | (64 << 32) | (56 << 48);
    img@[7]  = 1;      // e_phnum = 1
    img@[8]  = 1 | (5 << 32); // p_type = PT_LOAD (1), p_flags = PF_R | PF_X (5)
    img@[9]  = 0;
    img@[10] = 4194304; // p_vaddr = 0x400000
    img@[11] = 4194304;
    img@[12] = image_size;
    img@[13] = image_size;
    img@[14] = 4096; // p_align = 0x1000

    // 2. Startup Thunk (40 bytes) [Words 15..19]
    main_addr = 4194424 + 40 + 288 + main_offset;
    img@[15] = 72 | (139 << 8) | (12 << 16) | (36 << 24) | (72 << 32) | (141 << 40) | (84 << 48) | (36 << 56);
    img@[16] = 8 | (73 << 8) | (137 << 16) | (212 << 24) | (73 << 32) | (187 << 40) | ((main_addr & 65535) << 48);
    img@[17] = ((main_addr >> 16) & 281474976710655) | (65 << 48) | (255 << 56);
    img@[18] = 211 | (72 << 8) | (137 << 16) | (199 << 24) | (72 << 32) | (184 << 40) | (60 << 48);
    img@[19] = 364510094840299520;

    // 3. Thunk Header (288 bytes, 9 Thunks x 32-Byte Stride) [Words 20..55]
    loop (t_idx:36 = 0 .. 36) [
        img@[(20 + t_idx)] = 0;
    ]

    emit_thunk3!(img, 20, 16);                                                  // Thunk 0: sys_ioctl
    img@[24] = 76 | (137 << 8) | (224 << 16) | (195 << 24);                     // Thunk 1: get_argv
    emit_thunk3!(img, 28, 217);                                                 // Thunk 2: sys_getdents64
    img@[32] = 72 | (137 << 8) | (207 << 16) | (184 << 24) | (60 << 32);       // Thunk 3: sys_exit
    img@[33] = 15 | (5 << 8) | (195 << 16);
    img@[36] = 72 | (137 << 8) | (207 << 16) | (184 << 24) | (3 << 32);        // Thunk 4: sys_close
    img@[37] = 15 | (5 << 8) | (195 << 16);
    emit_thunk3!(img, 40, 1);                                                   // Thunk 5: sys_write
    emit_thunk3!(img, 44, 0);                                                   // Thunk 6: sys_read
    img@[48] = 72 | (137 << 8) | (207 << 16) | (72 << 24) | (137 << 32) | (214 << 40) | (186 << 48) | (164 << 56); // Thunk 7: sys_open
    img@[49] = 1 | (0 << 8) | (0 << 16) | (184 << 24) | (2 << 32) | (0 << 40) | (0 << 48) | (0 << 56);
    img@[50] = 15 | (5 << 8) | (195 << 16);
    img@[52] = -2987777575507459905;                                            // Thunk 8: sys_mmap
    img@[53] = 7663509400712774506;
    img@[54] = 678575907326673407;
    img@[55] = 3271888728;

    // 4. Read Payload Directly into Contiguous Image Buffer & Single Atomic Write
    code_bytes = sys_read!(safe_fd, img + 448, code_len);
    sys_close!(safe_fd);
    if (code_bytes != code_len) [
        sys_close!(elf_fd);
        sys_exit!(6);
    ]

    written = sys_write!(elf_fd, img, image_size);
    sys_close!(elf_fd);
    if (written != image_size) [
        sys_exit!(5);
    ]

    ret 0;
]
