// ==========================================
// steel/sys/driver_linux.sinc
// SINC Linux CLI Executable Driver
// ==========================================

fn main!(argc, argv_ptr) [
    if ((argc < 3)) [ sys_exit!(1); ]

    sys_mmap!(1073741824);

    in_path = get_argv!()@[1];
    out_path = get_argv!()@[2];

    fd_in = sys_open_read!(in_path);
    if (fd_in < 0) [
        sys_exit!(2);
    ]
    src_len = sys_read!(fd_in, 536870912, 10000000);
    sys_close!(fd_in);

    arena = arena_init!(553648128, 1000000000);

    out_payload = compile_core!(536870912, src_len, arena);

    fd_out = sys_open_write!(out_path);
    if (fd_out < 0) [
        sys_exit!(3);
    ]

    sys_write!(fd_out, out_payload@[2], 32);
    sys_write!(fd_out, out_payload@[0], out_payload@[1]);
    sys_close!(fd_out);

    sys_exit!(0);
]
