// ==========================================
// steel/sys/packager_obj_entry.sinc
// Standalone SINC .safe to Linux ELF .o Packager CLI
// ==========================================

fn main!(argc, argv_ptr) [
    if (argc < 3) [
        sys_exit!(1);
    ]

    safe_path = argv_ptr@[1];
    obj_path  = argv_ptr@[2];
    sym_name  = 0;
    if (argc > 3) [
        sym_name = argv_ptr@[3];
    ]

    raw_mem = sys_mmap!(160000000); // 160MB Arena
    if (raw_mem == -1) [
        sys_exit!(4); // Out of system memory
    ]
    arena = arena_init!(raw_mem, 160000000);
    res = pack_safe_to_obj!(safe_path, obj_path, sym_name, arena);
    sys_exit!(res);
]
