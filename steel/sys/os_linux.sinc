fn steel_proc_poll_trap!(pid, status_ptr) [
    ret 0;
]

// 6. Single-Step CPU Clock (Trap Flag TF) [Stub]
fn steel_proc_step!(pid) [
    ret 0;
]

// 7. Read 64-bit Memory Arena Word [Stub]
fn steel_proc_peek_word!(pid, addr) [
    ret 0;
]

// 8. Dump Physical CPU Registers [Stub]
fn steel_proc_peek_regs!(pid, regs_buf) [
    ret 0;
]
