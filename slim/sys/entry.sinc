// ==========================================
// slim/sys/entry.sinc
// S.L.I.M. SINC Linter & Inspection Module CLI
// Single Source of Truth Entrypoint
// ==========================================

fn slim_names_eq(ptr_a, len_a, ptr_b, len_b) [
    if (len_a != len_b) [ ret 0; ]
    loop (k:256 = 0 .. len_a) [
        if (ptr_a@[k * 1] != ptr_b@[k * 1]) [ ret 0; ]
    ]
    ret 1;
]

fn slim_str_len(ptr) [
    len = 0;
    stopped = 0;
    loop (k:1024 = 0 .. 1024) [
        if (stopped == 0) [
            if (ptr@[k * 1] == 0) [
                stopped = 1;
            ] else [
                len = len + 1;
            ]
        ]
    ]
    ret len;
]

fn slim_parse_dec(ptr, len) [
    val = 0;
    loop (i:32 = 0 .. len) [
        ch = ptr@[i * 1];
        if ((!(ch < 48)) & (ch < 58)) [
            val = (val * 10) + (ch - 48);
        ]
    ]
    ret val;
]

fn slim_print_mutate_pass!(buf) [
    off_ptr = buf + 3500;
    off_ptr@[0] = 0;
    // "[SLIM: PASS] Mutated bytecode binary generated.\n"
    diag_poke_ch!(buf, off_ptr, 91); diag_poke_ch!(buf, off_ptr, 83); diag_poke_ch!(buf, off_ptr, 76);
    diag_poke_ch!(buf, off_ptr, 73); diag_poke_ch!(buf, off_ptr, 77); diag_poke_ch!(buf, off_ptr, 58);
    diag_poke_ch!(buf, off_ptr, 32); diag_poke_ch!(buf, off_ptr, 80); diag_poke_ch!(buf, off_ptr, 65);
    diag_poke_ch!(buf, off_ptr, 83); diag_poke_ch!(buf, off_ptr, 83); diag_poke_ch!(buf, off_ptr, 93);
    diag_poke_ch!(buf, off_ptr, 32); diag_poke_ch!(buf, off_ptr, 77);
    diag_poke_ch!(buf, off_ptr, 117); diag_poke_ch!(buf, off_ptr, 116); diag_poke_ch!(buf, off_ptr, 97);
    diag_poke_ch!(buf, off_ptr, 116); diag_poke_ch!(buf, off_ptr, 101); diag_poke_ch!(buf, off_ptr, 100);
    diag_poke_ch!(buf, off_ptr, 32); diag_poke_ch!(buf, off_ptr, 98); diag_poke_ch!(buf, off_ptr, 121);
    diag_poke_ch!(buf, off_ptr, 116); diag_poke_ch!(buf, off_ptr, 101); diag_poke_ch!(buf, off_ptr, 99);
    diag_poke_ch!(buf, off_ptr, 111); diag_poke_ch!(buf, off_ptr, 100); diag_poke_ch!(buf, off_ptr, 101);
    diag_poke_ch!(buf, off_ptr, 32); diag_poke_ch!(buf, off_ptr, 98); diag_poke_ch!(buf, off_ptr, 105);
    diag_poke_ch!(buf, off_ptr, 110); diag_poke_ch!(buf, off_ptr, 97); diag_poke_ch!(buf, off_ptr, 114);
    diag_poke_ch!(buf, off_ptr, 121); diag_poke_ch!(buf, off_ptr, 46); diag_poke_ch!(buf, off_ptr, 10);
    sys_write!(1, buf, off_ptr@[0]);
    ret 0;
]

fn slim_load_tape!(arena, argc, argv, diag_buf, tape_info) [
    src_tape = arena_alloc_words!(arena, 4194304);
    file_table = arena_alloc_words!(arena, 4096);
    file_count = 0;
    tape_len = 0;
    target_path = argv@[2];
    target_len = slim_str_len(target_path);
    is_manifest = 0;
    if (target_len > 8) [
        off = target_len - 8;
        if ((target_path@[off * 1] == 46) & (target_path@[(off + 1) * 1] == 115) & (target_path@[(off + 2) * 1] == 111) & (target_path@[(off + 3) * 1] == 117) & (target_path@[(off + 4) * 1] == 114) & (target_path@[(off + 5) * 1] == 99) & (target_path@[(off + 6) * 1] == 101) & (target_path@[(off + 7) * 1] == 115)) [
            is_manifest = 1;
        ]
    ]
    if (target_len > 6) [
        off = target_len - 6;
        if ((target_path@[off * 1] == 46) & (target_path@[(off + 1) * 1] == 115) & (target_path@[(off + 2) * 1] == 116) & (target_path@[(off + 3) * 1] == 97) & (target_path@[(off + 4) * 1] == 102) & (target_path@[(off + 5) * 1] == 102)) [
            is_manifest = 1;
        ]
    ]
    if (is_manifest == 1) [
        m_fd = sys_open_read!(target_path);
        if (m_fd < 0) [
            diag_print_open_err!(diag_buf);
            sys_exit!(2);
        ]
        m_buf = arena_alloc_words!(arena, 8192);
        m_len = sys_read!(m_fd, m_buf, 65536);
        sys_close!(m_fd);
        if (m_len < 1) [
            diag_print_empty_err!(diag_buf);
            sys_exit!(2);
        ]
        m_pos = 0;
        loop (m_step:1000000 = 0 .. m_len) [
            if (m_pos < m_len) [
                ch = m_buf@[m_pos * 1];
                if ((ch == 32) | (ch == 9) | (ch == 10) | (ch == 13) | (ch == 0)) [
                    m_pos = m_pos + 1;
                ] else [
                    if (ch == 35) [
                        c_active = 1;
                        loop (csk:10000 = 0 .. 10000) [
                            if (c_active == 1) [
                                if (m_pos < m_len) [
                                    if (m_buf@[m_pos * 1] == 10) [
                                        m_pos = m_pos + 1;
                                        c_active = 0;
                                    ] else [
                                        m_pos = m_pos + 1;
                                    ]
                                ]
                            ]
                        ]
                    ] else [
                        path_start = m_pos;
                        p_active = 1;
                        loop (psk:10000 = 0 .. 10000) [
                            if (p_active == 1) [
                                if (m_pos < m_len) [
                                    pch = m_buf@[m_pos * 1];
                                    if ((pch == 10) | (pch == 13) | (pch == 32) | (pch == 9) | (pch == 0)) [
                                        p_active = 0;
                                    ] else [
                                        m_pos = m_pos + 1;
                                    ]
                                ]
                            ]
                        ]
                        path_len = m_pos - path_start;
                        if (path_len > 0) [
                            m_buf@[m_pos * 1] = 0;
                            m_pos = m_pos + 1;
                            f_path = m_buf + path_start;
                            f_fd = sys_open_read!(f_path);
                            if (f_fd < 0) [
                                diag_print_open_err!(diag_buf);
                                sys_exit!(2);
                            ]
                            max_read = 33554432 - tape_len;
                            read_bytes = sys_read!(f_fd, src_tape + tape_len, max_read);
                            sys_close!(f_fd);
                            if (read_bytes > 0) [
                                foff = file_count * 4;
                                file_table@[(foff + 0)] = f_path;
                                file_table@[(foff + 1)] = path_len;
                                file_table@[(foff + 2)] = tape_len;
                                file_table@[(foff + 3)] = tape_len + read_bytes;
                                file_count = file_count + 1;
                                tape_len = tape_len + read_bytes;
                                src_tape@[tape_len * 1] = 10;
                                tape_len = tape_len + 1;
                            ]
                        ]
                    ]
                ]
            ]
        ]
    ] else [
        loop (ai:1024 = 2 .. argc) [
            f_path = argv@[ai];
            path_len = slim_str_len(f_path);
            f_fd = sys_open_read!(f_path);
            if (f_fd < 0) [
                diag_print_open_err!(diag_buf);
                sys_exit!(2);
            ]
            max_read = 33554432 - tape_len;
            read_bytes = sys_read!(f_fd, src_tape + tape_len, max_read);
            sys_close!(f_fd);
            if (read_bytes > 0) [
                foff = file_count * 4;
                file_table@[(foff + 0)] = f_path;
                file_table@[(foff + 1)] = path_len;
                file_table@[(foff + 2)] = tape_len;
                file_table@[(foff + 3)] = tape_len + read_bytes;
                file_count = file_count + 1;
                tape_len = tape_len + read_bytes;
                src_tape@[tape_len * 1] = 10;
                tape_len = tape_len + 1;
            ]
        ]
    ]
    tape_info@[0] = src_tape;
    tape_info@[1] = tape_len;
    tape_info@[2] = file_table;
    tape_info@[3] = file_count;
    ret file_count;
]

fn main!(argc, argv_ptr) [
    // Initialize 64MB Arena
    sys_mmap!(67108864);
    arena = arena_init!(536870912, 603979776);
    diag_buf = arena_alloc_words!(arena, 512);

    if (argc < 2) [
        diag_print_usage!(diag_buf);
        sys_exit!(1);
    ]

    argv = get_argv!();
    subcmd_ptr = argv@[1];
    subcmd_len = slim_str_len(subcmd_ptr);

    // -----------------------------------------------------------------------
    // Command 1: 'check <source.sinc>' ('c'=99, 'h'=104, 'e'=101, 'c'=99, 'k'=107)
    // -----------------------------------------------------------------------
    if (subcmd_len == 5) [
        if ((subcmd_ptr@[0 * 1] == 99) & (subcmd_ptr@[1 * 1] == 104) & (subcmd_ptr@[2 * 1] == 101) & (subcmd_ptr@[3 * 1] == 99) & (subcmd_ptr@[4 * 1] == 107)) [
            if (argc < 3) [
                diag_print_missing_arg!(diag_buf);
                sys_exit!(1);
            ]

            tape_info = arena_alloc_words!(arena, 8);
            slim_load_tape!(arena, argc, argv, diag_buf, tape_info);

            src_buf    = tape_info@[0];
            src_len    = tape_info@[1];
            file_table = tape_info@[2];
            file_count = tape_info@[3];

            if (src_len < 1) [
                diag_print_empty_err!(diag_buf);
                sys_exit!(2);
            ]

            diag_buf@[450] = file_table;
            diag_buf@[451] = file_count;
            diag_buf@[452] = 0;

            violations = slim_lint_all!(arena, src_buf, src_len, diag_buf);

            if (violations > 0) [
                sys_exit!(1); // Halted by S.L.I.M.
            ]

            diag_print_pass!(diag_buf);
            sys_exit!(0);
        ]
    ]

    // -----------------------------------------------------------------------
    // Command 2: 'mutate <in.safe> <out.safe>' ('m'=109,'u'=117,'t'=116,'a'=97,'t'=116,'e'=101)
    // -----------------------------------------------------------------------
    if (subcmd_len == 6) [
        if ((subcmd_ptr@[0 * 1] == 109) & (subcmd_ptr@[1 * 1] == 117) & (subcmd_ptr@[2 * 1] == 116) & (subcmd_ptr@[3 * 1] == 97) & (subcmd_ptr@[4 * 1] == 116) & (subcmd_ptr@[5 * 1] == 101)) [
            if (argc < 4) [
                diag_print_missing_arg!(diag_buf);
                sys_exit!(1);
            ]

            in_path  = argv@[2];
            out_path = argv@[3];
            target_idx = 0;
            if (argc > 4) [
                idx_str = argv@[4];
                idx_len = slim_str_len(idx_str);
                target_idx = slim_parse_dec(idx_str, idx_len);
            ]
            m_res = slim_mutate_safe!(arena, in_path, out_path, target_idx);
            if (!(m_res > 0)) [
                diag_print_empty_err!(diag_buf);
                sys_exit!(2);
            ]

            slim_print_mutate_pass!(diag_buf);
            sys_exit!(0);
        ]
    ]

    // -----------------------------------------------------------------------
    // Command 3: 'eval-mutant <exit_code>' (len 11)
    // 'e'=101,'v'=118,'a'=97,'l'=108,'-'=45,'m'=109,'u'=117,'t'=116,'a'=97,'n'=110,'t'=116
    // -----------------------------------------------------------------------
    if (subcmd_len == 11) [
        if ((subcmd_ptr@[0 * 1] == 101) & (subcmd_ptr@[1 * 1] == 118) & (subcmd_ptr@[2 * 1] == 97) & (subcmd_ptr@[3 * 1] == 108) & (subcmd_ptr@[4 * 1] == 45) & (subcmd_ptr@[5 * 1] == 109)) [
            if (argc < 3) [
                diag_print_missing_arg!(diag_buf);
                sys_exit!(1);
            ]

            arg_str = argv@[2];
            arg_len = slim_str_len(arg_str);
            code = slim_parse_dec(arg_str, arg_len);
            res = slim_eval_mutant_result!(diag_buf, code, 0, 0);
            sys_exit!(res);
        ]
    ]

    // -----------------------------------------------------------------------
    // Command 4: 'verify-trace <trace_count>' (len 12)
    // 'v'=118,'e'=101,'r'=114,'i'=105,'f'=102,'y'=121,'-'=45,'t'=116,'r'=114,'a'=97,'c'=99,'e'=101
    // -----------------------------------------------------------------------
    if (subcmd_len == 12) [
        if ((subcmd_ptr@[0 * 1] == 118) & (subcmd_ptr@[6 * 1] == 45) & (subcmd_ptr@[7 * 1] == 116)) [
            if (argc < 3) [
                diag_print_missing_arg!(diag_buf);
                sys_exit!(1);
            ]

            arg_str = argv@[2];
            arg_len = slim_str_len(arg_str);
            cnt = slim_parse_dec(arg_str, arg_len);
            res = slim_eval_trace!(diag_buf, cnt, 0, 0);
            sys_exit!(res);
        ]
    ]

    // -----------------------------------------------------------------------
    // Command 5: 'verify-bench <cycles> <baseline_ceiling>' (len 12)
    // 'v'=118,'e'=101,'r'=114,'i'=105,'f'=102,'y'=121,'-'=45,'b'=98,'e'=101,'n'=110,'c'=99,'h'=104
    // -----------------------------------------------------------------------
    if (subcmd_len == 12) [
        if ((subcmd_ptr@[0 * 1] == 118) & (subcmd_ptr@[6 * 1] == 45) & (subcmd_ptr@[7 * 1] == 98)) [
            if (argc < 4) [
                diag_print_missing_arg!(diag_buf);
                sys_exit!(1);
            ]

            c_str = argv@[2];
            c_len = slim_str_len(c_str);
            current_c = slim_parse_dec(c_str, c_len);

            b_str = argv@[3];
            b_len = slim_str_len(b_str);
            baseline_ceil = slim_parse_dec(b_str, b_len);

            res = slim_eval_bench!(diag_buf, current_c, baseline_ceil, 0, 0);
            sys_exit!(res);
        ]
    ]

    diag_print_unknown_cmd!(diag_buf);
    sys_exit!(1);
]
