fn diag_emit_tag!(buf, tag_type, line_num, name_ptr, name_len) [
    off_ptr = buf + 3500;
    off_ptr@[0] = 0;

    // 1. Tag Prefix: "[TAG: "
    diag_poke_ch!(buf, off_ptr, 91); // '['
    diag_poke_ch!(buf, off_ptr, 84); // 'T'
    diag_poke_ch!(buf, off_ptr, 65); // 'A'
    diag_poke_ch!(buf, off_ptr, 71); // 'G'
    diag_poke_ch!(buf, off_ptr, 58); // ':'
    diag_poke_ch!(buf, off_ptr, 32); // ' '

    if (tag_type == TAG_LAZY) [
        // "LAZY] "
        diag_poke_ch!(buf, off_ptr, 76); diag_poke_ch!(buf, off_ptr, 65);
        diag_poke_ch!(buf, off_ptr, 90); diag_poke_ch!(buf, off_ptr, 89);
        diag_poke_ch!(buf, off_ptr, 93); diag_poke_ch!(buf, off_ptr, 32);
    ]
    if (tag_type == TAG_DEAD_WEIGHT) [
        // "DEAD WEIGHT] "
        diag_poke_ch!(buf, off_ptr, 68); diag_poke_ch!(buf, off_ptr, 69);
        diag_poke_ch!(buf, off_ptr, 65); diag_poke_ch!(buf, off_ptr, 68);
        diag_poke_ch!(buf, off_ptr, 32); diag_poke_ch!(buf, off_ptr, 87);
        diag_poke_ch!(buf, off_ptr, 69); diag_poke_ch!(buf, off_ptr, 73);
        diag_poke_ch!(buf, off_ptr, 71); diag_poke_ch!(buf, off_ptr, 72);
        diag_poke_ch!(buf, off_ptr, 84); diag_poke_ch!(buf, off_ptr, 93);
        diag_poke_ch!(buf, off_ptr, 32);
    ]
    if (tag_type == TAG_UNNECESSARY) [
        // "UNNECESSARY] "
        diag_poke_ch!(buf, off_ptr, 85); diag_poke_ch!(buf, off_ptr, 78);
        diag_poke_ch!(buf, off_ptr, 78); diag_poke_ch!(buf, off_ptr, 69);
        diag_poke_ch!(buf, off_ptr, 67); diag_poke_ch!(buf, off_ptr, 69);
        diag_poke_ch!(buf, off_ptr, 83); diag_poke_ch!(buf, off_ptr, 83);
        diag_poke_ch!(buf, off_ptr, 65); diag_poke_ch!(buf, off_ptr, 82);
        diag_poke_ch!(buf, off_ptr, 89); diag_poke_ch!(buf, off_ptr, 93);
        diag_poke_ch!(buf, off_ptr, 32);
    ]
    if (tag_type == TAG_UNVERIFIED) [
        // "UNVERIFIED] "
        diag_poke_ch!(buf, off_ptr, 85); diag_poke_ch!(buf, off_ptr, 78);
        diag_poke_ch!(buf, off_ptr, 86); diag_poke_ch!(buf, off_ptr, 69);
        diag_poke_ch!(buf, off_ptr, 82); diag_poke_ch!(buf, off_ptr, 73);
        diag_poke_ch!(buf, off_ptr, 70); diag_poke_ch!(buf, off_ptr, 73);
        diag_poke_ch!(buf, off_ptr, 69); diag_poke_ch!(buf, off_ptr, 68);
        diag_poke_ch!(buf, off_ptr, 93); diag_poke_ch!(buf, off_ptr, 32);
    ]
    if (tag_type == TAG_WEAK_TEST) [
        // "WEAK TEST] "
        diag_poke_ch!(buf, off_ptr, 87); diag_poke_ch!(buf, off_ptr, 69);
        diag_poke_ch!(buf, off_ptr, 65); diag_poke_ch!(buf, off_ptr, 75);
        diag_poke_ch!(buf, off_ptr, 32); diag_poke_ch!(buf, off_ptr, 84);
        diag_poke_ch!(buf, off_ptr, 69); diag_poke_ch!(buf, off_ptr, 83);
        diag_poke_ch!(buf, off_ptr, 84); diag_poke_ch!(buf, off_ptr, 93);
        diag_poke_ch!(buf, off_ptr, 32);
    ]
    if (tag_type == TAG_REGRESSION) [
        // "REGRESSION] "
        diag_poke_ch!(buf, off_ptr, 82); diag_poke_ch!(buf, off_ptr, 69);
        diag_poke_ch!(buf, off_ptr, 71); diag_poke_ch!(buf, off_ptr, 82);
        diag_poke_ch!(buf, off_ptr, 69); diag_poke_ch!(buf, off_ptr, 83);
        diag_poke_ch!(buf, off_ptr, 83); diag_poke_ch!(buf, off_ptr, 73);
        diag_poke_ch!(buf, off_ptr, 79); diag_poke_ch!(buf, off_ptr, 78);
        diag_poke_ch!(buf, off_ptr, 93); diag_poke_ch!(buf, off_ptr, 32);
    ]
    if (tag_type == TAG_GHOST) [
        // "GHOST] "
        diag_poke_ch!(buf, off_ptr, 71); diag_poke_ch!(buf, off_ptr, 72);
        diag_poke_ch!(buf, off_ptr, 79); diag_poke_ch!(buf, off_ptr, 83);
        diag_poke_ch!(buf, off_ptr, 84); diag_poke_ch!(buf, off_ptr, 93);
        diag_poke_ch!(buf, off_ptr, 32);
    ]
    if (tag_type == TAG_SPIN) [
        // "SPIN] "
        diag_poke_ch!(buf, off_ptr, 83); diag_poke_ch!(buf, off_ptr, 80);
        diag_poke_ch!(buf, off_ptr, 73); diag_poke_ch!(buf, off_ptr, 78);
        diag_poke_ch!(buf, off_ptr, 93); diag_poke_ch!(buf, off_ptr, 32);
    ]
    if (tag_type == TAG_EAGER) [
        // "EAGER] "
        diag_poke_ch!(buf, off_ptr, 69); diag_poke_ch!(buf, off_ptr, 65);
        diag_poke_ch!(buf, off_ptr, 71); diag_poke_ch!(buf, off_ptr, 69);
        diag_poke_ch!(buf, off_ptr, 82); diag_poke_ch!(buf, off_ptr, 93);
        diag_poke_ch!(buf, off_ptr, 32);
    ]
    if (tag_type == TAG_BANDAID) [
        // "BANDAID] "
        diag_poke_ch!(buf, off_ptr, 66); diag_poke_ch!(buf, off_ptr, 65);
        diag_poke_ch!(buf, off_ptr, 78); diag_poke_ch!(buf, off_ptr, 68);
        diag_poke_ch!(buf, off_ptr, 65); diag_poke_ch!(buf, off_ptr, 73);
        diag_poke_ch!(buf, off_ptr, 68); diag_poke_ch!(buf, off_ptr, 93);
        diag_poke_ch!(buf, off_ptr, 32);
    ]
    if (tag_type == TAG_SPLINTER) [
        // "SPLINTER] "
        diag_poke_ch!(buf, off_ptr, 83); diag_poke_ch!(buf, off_ptr, 80);
        diag_poke_ch!(buf, off_ptr, 76); diag_poke_ch!(buf, off_ptr, 73);
        diag_poke_ch!(buf, off_ptr, 78); diag_poke_ch!(buf, off_ptr, 84);
        diag_poke_ch!(buf, off_ptr, 69); diag_poke_ch!(buf, off_ptr, 82);
        diag_poke_ch!(buf, off_ptr, 93); diag_poke_ch!(buf, off_ptr, 32);
    ]
    if (tag_type == TAG_FOSSIL) [
        // "FOSSIL] "
        diag_poke_ch!(buf, off_ptr, 70); diag_poke_ch!(buf, off_ptr, 79);
        diag_poke_ch!(buf, off_ptr, 83); diag_poke_ch!(buf, off_ptr, 83);
        diag_poke_ch!(buf, off_ptr, 73); diag_poke_ch!(buf, off_ptr, 76);
        diag_poke_ch!(buf, off_ptr, 93); diag_poke_ch!(buf, off_ptr, 32);
    ]
    if (tag_type == TAG_OVERCHECK) [
        // "OVERCHECK] "
        diag_poke_ch!(buf, off_ptr, 79); diag_poke_ch!(buf, off_ptr, 86);
        diag_poke_ch!(buf, off_ptr, 69); diag_poke_ch!(buf, off_ptr, 82);
        diag_poke_ch!(buf, off_ptr, 67); diag_poke_ch!(buf, off_ptr, 72);
        diag_poke_ch!(buf, off_ptr, 69); diag_poke_ch!(buf, off_ptr, 67);
        diag_poke_ch!(buf, off_ptr, 75); diag_poke_ch!(buf, off_ptr, 93);
        diag_poke_ch!(buf, off_ptr, 32);
    ]
    if (tag_type == TAG_REFETCH) [
        // "REFETCH] "
        diag_poke_ch!(buf, off_ptr, 82); diag_poke_ch!(buf, off_ptr, 69);
        diag_poke_ch!(buf, off_ptr, 70); diag_poke_ch!(buf, off_ptr, 69);
        diag_poke_ch!(buf, off_ptr, 84); diag_poke_ch!(buf, off_ptr, 67);
        diag_poke_ch!(buf, off_ptr, 72); diag_poke_ch!(buf, off_ptr, 93);
        diag_poke_ch!(buf, off_ptr, 32);
    ]
    if (tag_type == TAG_RAWDATA) [
        // "RAWDATA] "
        diag_poke_ch!(buf, off_ptr, 82); diag_poke_ch!(buf, off_ptr, 65);
        diag_poke_ch!(buf, off_ptr, 87); diag_poke_ch!(buf, off_ptr, 68);
        diag_poke_ch!(buf, off_ptr, 65); diag_poke_ch!(buf, off_ptr, 84);
        diag_poke_ch!(buf, off_ptr, 65); diag_poke_ch!(buf, off_ptr, 93);
        diag_poke_ch!(buf, off_ptr, 32);
    ]
    if (tag_type == TAG_WRAPPER) [
        // "WRAPPER] "
        diag_poke_ch!(buf, off_ptr, 87); diag_poke_ch!(buf, off_ptr, 82);
        diag_poke_ch!(buf, off_ptr, 65); diag_poke_ch!(buf, off_ptr, 80);
        diag_poke_ch!(buf, off_ptr, 80); diag_poke_ch!(buf, off_ptr, 69);
        diag_poke_ch!(buf, off_ptr, 82); diag_poke_ch!(buf, off_ptr, 93);
        diag_poke_ch!(buf, off_ptr, 32);
    ]

    file_table = buf@[450];
    file_count = buf@[451];
    file_idx   = buf@[452];

    if ((file_count > 1) & (file_table != 0)) [
        foff = file_idx * 4;
        f_path = file_table@[(foff + 0)];
        f_len  = file_table@[(foff + 1)];
        if (f_len > 0) [
            diag_poke_str!(buf, off_ptr, f_path, f_len);
            diag_poke_ch!(buf, off_ptr, 58); // ':'
        ]
    ]

    // 2. Line number (if > 0): "line N: "
    if (line_num > 0) [
        diag_poke_ch!(buf, off_ptr, 108); // 'l'
        diag_poke_ch!(buf, off_ptr, 105); // 'i'
        diag_poke_ch!(buf, off_ptr, 110); // 'n'
        diag_poke_ch!(buf, off_ptr, 101); // 'e'
        diag_poke_ch!(buf, off_ptr, 32);  // ' '
        diag_poke_dec!(buf, off_ptr, line_num);
        diag_poke_ch!(buf, off_ptr, 58);  // ':'
        diag_poke_ch!(buf, off_ptr, 32);  // ' '
    ]

    // 3. Name or identifier
    if (name_len > 0) [
        diag_poke_str!(buf, off_ptr, name_ptr, name_len);
    ]

    // 4. Detailed description
    if (tag_type == TAG_LAZY) [
        diag_poke_lazy_desc!(buf, off_ptr);
    ]
    if (tag_type == TAG_DEAD_WEIGHT) [
        diag_poke_dead_weight_desc!(buf, off_ptr);
    ]
    if (tag_type == TAG_UNNECESSARY) [
        diag_poke_unnecessary_desc!(buf, off_ptr);
    ]
    if (tag_type == TAG_UNVERIFIED) [
        diag_poke_unverified_desc!(buf, off_ptr);
    ]
    if (tag_type == TAG_WEAK_TEST) [
        diag_poke_weak_test_desc!(buf, off_ptr);
    ]
    if (tag_type == TAG_REGRESSION) [
        diag_poke_regression_desc!(buf, off_ptr);
    ]
    if (tag_type == TAG_GHOST) [
        diag_poke_ghost_desc!(buf, off_ptr);
    ]
    if (tag_type == TAG_SPIN) [
        diag_poke_spin_desc!(buf, off_ptr);
    ]
    if (tag_type == TAG_EAGER) [
        diag_poke_eager_desc!(buf, off_ptr);
    ]
    if (tag_type == TAG_BANDAID) [
        diag_poke_bandaid_desc!(buf, off_ptr);
    ]
    if (tag_type == TAG_SPLINTER) [
        diag_poke_splinter_desc!(buf, off_ptr);
    ]
    if (tag_type == TAG_FOSSIL) [
        diag_poke_fossil_desc!(buf, off_ptr);
    ]
    if (tag_type == TAG_OVERCHECK) [
        diag_poke_overcheck_desc!(buf, off_ptr);
    ]
    if (tag_type == TAG_REFETCH) [
        diag_poke_refetch_desc!(buf, off_ptr);
    ]
    if (tag_type == TAG_RAWDATA) [
        diag_poke_rawdata_desc!(buf, off_ptr);
    ]
    if (tag_type == TAG_WRAPPER) [
        diag_poke_wrapper_desc!(buf, off_ptr);
    ]

    diag_poke_ch!(buf, off_ptr, 10); // '\n'

    // Flush to stderr (FD 2)
    total_len = off_ptr@[0];
    sys_write!(2, buf, total_len);
    ret total_len;
]

fn diag_print_pass!(buf) [
    off_ptr = buf + 3500;
    off_ptr@[0] = 0;
    // "[SLIM: PASS] All static architectural constraints satisfied.\n"
    diag_poke_ch!(buf, off_ptr, 91); diag_poke_ch!(buf, off_ptr, 83); diag_poke_ch!(buf, off_ptr, 76);
    diag_poke_ch!(buf, off_ptr, 73); diag_poke_ch!(buf, off_ptr, 77); diag_poke_ch!(buf, off_ptr, 58);
    diag_poke_ch!(buf, off_ptr, 32); diag_poke_ch!(buf, off_ptr, 80); diag_poke_ch!(buf, off_ptr, 65);
    diag_poke_ch!(buf, off_ptr, 83); diag_poke_ch!(buf, off_ptr, 83); diag_poke_ch!(buf, off_ptr, 93);
    diag_poke_ch!(buf, off_ptr, 32); diag_poke_ch!(buf, off_ptr, 65); diag_poke_ch!(buf, off_ptr, 108);
    diag_poke_ch!(buf, off_ptr, 108); diag_poke_ch!(buf, off_ptr, 32);
