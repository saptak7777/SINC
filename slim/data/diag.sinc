// ==========================================
// slim/data/diag.sinc
// S.L.I.M. Structured Diagnostic Protocol
// Single Source of Truth for Diagnostic Tag Emitting
// Zero double-quote string literals (SINC AST-Free Compliant)
// ==========================================

const TAG_LAZY        = 1;
const TAG_DEAD_WEIGHT = 2;
const TAG_UNNECESSARY = 3;
const TAG_UNVERIFIED  = 4;
const TAG_WEAK_TEST   = 5;
const TAG_REGRESSION  = 6;
const TAG_GHOST       = 7;
const TAG_SPIN        = 8;
const TAG_EAGER       = 9;
const TAG_BANDAID     = 10;
const TAG_SPLINTER    = 11;
const TAG_FOSSIL      = 12;
const TAG_OVERCHECK   = 13;
const TAG_REFETCH     = 14;
const TAG_RAWDATA     = 15;
const TAG_WRAPPER     = 16;

fn diag_poke_ch!(buf, off_ptr, ch) [
    idx = off_ptr@[0];
    buf@[idx * 1] = ch;
    off_ptr@[0] = idx + 1;
    ret 0;
]

fn diag_poke_str!(buf, off_ptr, str_ptr, len) [
    if (len > 0) [
        loop (i:10000 = 0 .. len) [
            ch = str_ptr@[i * 1];
            diag_poke_ch!(buf, off_ptr, ch);
        ]
    ]
    ret 0;
]

fn diag_poke_dec!(buf, off_ptr, val) [
    if (val == 0) [
        diag_poke_ch!(buf, off_ptr, 48); // '0'
        ret 0;
    ]
    v = val;
    if (v > 999) [
        d = v / 1000;
        diag_poke_ch!(buf, off_ptr, d + 48);
        v = v - (d * 1000);
    ]
    if (v > 99) [
        d = v / 100;
        diag_poke_ch!(buf, off_ptr, d + 48);
        v = v - (d * 100);
    ]
    if (v > 9) [
        d = v / 10;
        diag_poke_ch!(buf, off_ptr, d + 48);
        v = v - (d * 10);
    ]
    diag_poke_ch!(buf, off_ptr, v + 48);
    ret 0;
]

fn diag_poke_lazy_desc!(buf, off_ptr) [
    // "statement complexity exceeds cap (4). Unroll into multi-line steps."
    // 's'=115, 't'=116, 'a'=97, 't'=116, 'e'=101, 'm'=109, 'e'=101, 'n'=110, 't'=116, ' '=32
    diag_poke_ch!(buf, off_ptr, 115); diag_poke_ch!(buf, off_ptr, 116); diag_poke_ch!(buf, off_ptr, 97);
    diag_poke_ch!(buf, off_ptr, 116); diag_poke_ch!(buf, off_ptr, 101); diag_poke_ch!(buf, off_ptr, 109);
    diag_poke_ch!(buf, off_ptr, 101); diag_poke_ch!(buf, off_ptr, 110); diag_poke_ch!(buf, off_ptr, 116);
    diag_poke_ch!(buf, off_ptr, 32);
    // "complexity "
    diag_poke_ch!(buf, off_ptr, 99); diag_poke_ch!(buf, off_ptr, 111); diag_poke_ch!(buf, off_ptr, 109);
    diag_poke_ch!(buf, off_ptr, 112); diag_poke_ch!(buf, off_ptr, 108); diag_poke_ch!(buf, off_ptr, 101);
    diag_poke_ch!(buf, off_ptr, 120); diag_poke_ch!(buf, off_ptr, 105); diag_poke_ch!(buf, off_ptr, 116);
    diag_poke_ch!(buf, off_ptr, 121); diag_poke_ch!(buf, off_ptr, 32);
    // "exceeds cap (4). Unroll into multi-line steps."
    diag_poke_ch!(buf, off_ptr, 101); diag_poke_ch!(buf, off_ptr, 120); diag_poke_ch!(buf, off_ptr, 99);
    diag_poke_ch!(buf, off_ptr, 101); diag_poke_ch!(buf, off_ptr, 101); diag_poke_ch!(buf, off_ptr, 100);
    diag_poke_ch!(buf, off_ptr, 115); diag_poke_ch!(buf, off_ptr, 32); diag_poke_ch!(buf, off_ptr, 99);
    diag_poke_ch!(buf, off_ptr, 97); diag_poke_ch!(buf, off_ptr, 112); diag_poke_ch!(buf, off_ptr, 32);
    diag_poke_ch!(buf, off_ptr, 40); diag_poke_ch!(buf, off_ptr, 52); diag_poke_ch!(buf, off_ptr, 41);
    diag_poke_ch!(buf, off_ptr, 46); diag_poke_ch!(buf, off_ptr, 32); diag_poke_ch!(buf, off_ptr, 85);
    diag_poke_ch!(buf, off_ptr, 110); diag_poke_ch!(buf, off_ptr, 114); diag_poke_ch!(buf, off_ptr, 111);
    diag_poke_ch!(buf, off_ptr, 108); diag_poke_ch!(buf, off_ptr, 108); diag_poke_ch!(buf, off_ptr, 32);
    diag_poke_ch!(buf, off_ptr, 105); diag_poke_ch!(buf, off_ptr, 110); diag_poke_ch!(buf, off_ptr, 116);
    diag_poke_ch!(buf, off_ptr, 111); diag_poke_ch!(buf, off_ptr, 32); diag_poke_ch!(buf, off_ptr, 109);
    diag_poke_ch!(buf, off_ptr, 117); diag_poke_ch!(buf, off_ptr, 108); diag_poke_ch!(buf, off_ptr, 116);
    diag_poke_ch!(buf, off_ptr, 105); diag_poke_ch!(buf, off_ptr, 45); diag_poke_ch!(buf, off_ptr, 108);
    diag_poke_ch!(buf, off_ptr, 105); diag_poke_ch!(buf, off_ptr, 110); diag_poke_ch!(buf, off_ptr, 101);
    diag_poke_ch!(buf, off_ptr, 32); diag_poke_ch!(buf, off_ptr, 115); diag_poke_ch!(buf, off_ptr, 116);
    diag_poke_ch!(buf, off_ptr, 101); diag_poke_ch!(buf, off_ptr, 112); diag_poke_ch!(buf, off_ptr, 115);
    diag_poke_ch!(buf, off_ptr, 46);
    ret 0;
]

