fn diag_poke_ghost_desc!(buf, off_ptr) [
    // " written but never read in scope. Remove or propagate."
    // ' '=32 'w'=119 'r'=114 'i'=105 't'=116 't'=116 'e'=101 'n'=110
    diag_poke_ch!(buf, off_ptr, 32);  diag_poke_ch!(buf, off_ptr, 119); diag_poke_ch!(buf, off_ptr, 114);
    diag_poke_ch!(buf, off_ptr, 105); diag_poke_ch!(buf, off_ptr, 116); diag_poke_ch!(buf, off_ptr, 116);
    diag_poke_ch!(buf, off_ptr, 101); diag_poke_ch!(buf, off_ptr, 110); diag_poke_ch!(buf, off_ptr, 32);
    // 'b'=98 'u'=117 't'=116 ' '=32 'n'=110 'e'=101 'v'=118 'e'=101 'r'=114
    diag_poke_ch!(buf, off_ptr, 98);  diag_poke_ch!(buf, off_ptr, 117); diag_poke_ch!(buf, off_ptr, 116);
    diag_poke_ch!(buf, off_ptr, 32);  diag_poke_ch!(buf, off_ptr, 110); diag_poke_ch!(buf, off_ptr, 101);
    diag_poke_ch!(buf, off_ptr, 118); diag_poke_ch!(buf, off_ptr, 101); diag_poke_ch!(buf, off_ptr, 114);
    // ' '=32 'r'=114 'e'=101 'a'=97 'd'=100 ' '=32 'i'=105 'n'=110 ' '=32
    diag_poke_ch!(buf, off_ptr, 32);  diag_poke_ch!(buf, off_ptr, 114); diag_poke_ch!(buf, off_ptr, 101);
    diag_poke_ch!(buf, off_ptr, 97);  diag_poke_ch!(buf, off_ptr, 100); diag_poke_ch!(buf, off_ptr, 32);
    // 's'=115 'c'=99 'o'=111 'p'=112 'e'=101 '.'=46
    diag_poke_ch!(buf, off_ptr, 115); diag_poke_ch!(buf, off_ptr, 99);  diag_poke_ch!(buf, off_ptr, 111);
    diag_poke_ch!(buf, off_ptr, 112); diag_poke_ch!(buf, off_ptr, 101); diag_poke_ch!(buf, off_ptr, 46);
    ret 0;
]

