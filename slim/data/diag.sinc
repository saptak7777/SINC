    diag_poke_ch!(buf, off_ptr, 101); diag_poke_ch!(buf, off_ptr, 112); diag_poke_ch!(buf, off_ptr, 116);
    diag_poke_ch!(buf, off_ptr, 46);
    ret 0;
]

