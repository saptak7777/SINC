// ==========================================
// lit/pure/staff_manifest.sinc
// LIT Runtime: Pure .staff Manifest Dependency Parser
// ==========================================

fn is_manifest_ws(c) [
    if ((c == 32) | (c == 9) | (c == 10) | (c == 13)) [
        ret 1;
    ]
    ret 0;
]

fn parse_staff_artifact_name!(man_buf, man_len, out_name_buf) [
    cursor = 0;
    found_name = 0;
    loop (step = 0 .. 5000) [
        if (found_name == 0) [
            if (!(cursor < man_len)) [
                found_name = 1;
            ] else [
                c = man_buf@[cursor * 1];
                if ((c == 97) & (!((cursor + 8) > man_len))) [
                    if ((man_buf@[(cursor + 1) * 1] == 114) & (man_buf@[(cursor + 2) * 1] == 116) & (man_buf@[(cursor + 3) * 1] == 105) & (man_buf@[(cursor + 4) * 1] == 102) & (man_buf@[(cursor + 5) * 1] == 97) & (man_buf@[(cursor + 6) * 1] == 99) & (man_buf@[(cursor + 7) * 1] == 116)) [
                        cursor = cursor + 8;
                        skip_ws = 1;
                        loop (ws = 0 .. 100) [
                            if ((skip_ws != 0) & (cursor < man_len)) [
                                sc = man_buf@[cursor * 1];
                                if (is_manifest_ws(sc) != 0) [
                                    cursor = cursor + 1;
                                ] else [
                                    skip_ws = 0;
                                ]
                            ]
                        ]
                        name_start = cursor;
                        read_name = 1;
                        loop (rn = 0 .. 100) [
                            if ((read_name != 0) & (cursor < man_len)) [
                                nc = man_buf@[cursor * 1];
                                if ((is_manifest_ws(nc) != 0) | (nc == 91)) [
                                    read_name = 0;
                                ] else [
                                    cursor = cursor + 1;
                                ]
                            ]
                        ]
                        name_len = cursor - name_start;
                        if (name_len > 0) [
                            loop (k = 0 .. name_len) [
                                out_name_buf@[k * 1] = man_buf@[(name_start + k) * 1];
                            ]
                            out_name_buf@[name_len * 1] = 0;
                            ret name_len;
                        ]
                    ]
                ]
                cursor = cursor + 1;
            ]
        ]
    ]
    ret 0;
]

fn parse_staff_deps!(man_buf, man_len, deps_out) [
    count = 0;
    cursor = 0;

    loop (step = 0 .. 1000000) [
        if (!(cursor < man_len)) [
            ret count;
        ]

        c = man_buf@[cursor * 1];

        if ((c == 47) & ((cursor + 1) < man_len)) [
            next_c = man_buf@[(cursor + 1) * 1];
            if (next_c == 47) [
                cursor = cursor + 2;
                in_comm = 1;
                loop (skip = 0 .. 10000) [
                    if ((in_comm != 0) & (cursor < man_len)) [
                        sc = man_buf@[cursor * 1];
                        cursor = cursor + 1;
                        if ((sc == 10) | (sc == 13)) [
                            in_comm = 0;
                        ]
                    ]
                ]
                c = 32;
            ]
        ]

        is_section = 0;
        if ((c == 100) & (!((cursor + 4) > man_len))) [
            if ((man_buf@[(cursor + 1) * 1] == 101) & (man_buf@[(cursor + 2) * 1] == 112) & (man_buf@[(cursor + 3) * 1] == 115)) [
                is_section = 1;
                cursor = cursor + 4;
            ]
        ]
        if ((is_section == 0) & (c == 100) & (!((cursor + 6) > man_len))) [
            if ((man_buf@[(cursor + 1) * 1] == 114) & (man_buf@[(cursor + 2) * 1] == 105) & (man_buf@[(cursor + 3) * 1] == 118) & (man_buf@[(cursor + 4) * 1] == 101) & (man_buf@[(cursor + 5) * 1] == 114)) [
                is_section = 1;
                cursor = cursor + 6;
            ]
        ]

        if (is_section != 0) [
            found_bracket = 0;
            loop (sb = 0 .. 1000) [
                if ((found_bracket == 0) & (cursor < man_len)) [
                    bc = man_buf@[cursor * 1];
                    cursor = cursor + 1;
                    if (bc == 91) [
                        found_bracket = 1;
                    ]
                ]
            ]

            if (found_bracket != 0) [
                in_list = 1;
                loop (item = 0 .. 500) [
                    if ((in_list != 0) & (cursor < man_len)) [
                        skip_ws = 1;
                        loop (ws_loop = 0 .. 1000) [
                            if ((skip_ws != 0) & (cursor < man_len)) [
                                ch = man_buf@[cursor * 1];
                                if (is_manifest_ws(ch) != 0) [
                                    cursor = cursor + 1;
                                ] else [
                                    if ((ch == 47) & ((cursor + 1) < man_len)) [
                                        if (man_buf@[(cursor + 1) * 1] == 47) [
                                            cursor = cursor + 2;
                                            c_comm = 1;
                                            loop (comm = 0 .. 1000) [
                                                if ((c_comm != 0) & (cursor < man_len)) [
                                                    cc = man_buf@[cursor * 1];
                                                    cursor = cursor + 1;
                                                    if ((cc == 10) | (cc == 13)) [
                                                        c_comm = 0;
                                                    ]
                                                ]
                                            ]
                                        ] else [
                                            skip_ws = 0;
                                        ]
                                    ] else [
                                        skip_ws = 0;
                                    ]
                                ]
                            ]
                        ]

                        if (cursor < man_len) [
                            cur_ch = man_buf@[cursor * 1];
                            if (cur_ch == 93) [
                                in_list = 0;
                                cursor = cursor + 1;
                            ] else [
                                tok_start = cursor;
                                read_tok = 1;
                                loop (rd = 0 .. 1000) [
                                    if ((read_tok != 0) & (cursor < man_len)) [
                                        tc = man_buf@[cursor * 1];
                                        cursor = cursor + 1;
                                        if (tc == 59) [
                                            read_tok = 0;
                                        ]
                                    ]
                                ]
                                tok_len = cursor - 1 - tok_start;
                                trim_ws = 1;
                                loop (trim = 0 .. 100) [
                                    if ((trim_ws != 0) & (tok_len > 0)) [
                                        last_c = man_buf@[(tok_start + tok_len - 1) * 1];
                                        if (is_manifest_ws(last_c) != 0) [
                                            tok_len = tok_len - 1;
                                        ] else [
                                            trim_ws = 0;
                                        ]
                                    ]
                                ]

                                if (tok_len > 0) [
                                    man_buf@[(tok_start + tok_len) * 1] = 0;
                                    deps_out@[count] = man_buf + tok_start;
                                    count = count + 1;
                                ]
                            ]
                        ]
                    ]
                ]
            ]
        ] else [
            cursor = cursor + 1;
        ]
    ]
    ret count;
]
