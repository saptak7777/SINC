// EXPECT: 30
// Test: Multiple sub-term ALU operations and multiplication in a loop
fn main() [
    total = 0;
    loop (i:20 = 0 .. 20) [
        a = (i & 7) + 1;
        b = (i & 3) + 2;
        c = (i & 1) + 3;
        prod = c * (a + b);
        total = total + prod;
    ]
    ret (total & 255);
]
