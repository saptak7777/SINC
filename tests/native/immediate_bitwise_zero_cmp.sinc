// EXPECT: 186
// Test: Immediate bitwise operations with direct destination and zero-test comparisons
fn main() [
    score = 0;
    x = 105;
    y = 42;

    // Direct immediate bitwise
    a = x & 15;  // 105 & 15 = 9
    b = y | 3;   // 42 | 3 = 43
    c = x ^ 127; // 105 ^ 127 = 22

    if ((a & 1) != 0) [ score = score + 1; ]  // 9 & 1 = 1 != 0 -> +1
    if ((b & 1) != 0) [ score = score + 2; ]  // 43 & 1 = 1 != 0 -> +2
    if ((c & 1) == 0) [ score = score + 4; ]  // 22 & 1 = 0 == 0 -> +4

    // Immediate arithmetic
    d = a + 10;  // 19
    e = b - 3;   // 40
    if (d == 19) [ score = score + 8; ]       // +8
    if (e == 40) [ score = score + 16; ]      // +16

    // In a loop
    loop (i:10 = 0 .. 10) [
        if ((i & 1) == 0) [
            score = score + 15; // 5 even numbers * 15 = 75
        ] else [
            score = score + 16; // 5 odd numbers * 16 = 80
        ]
    ]

    ret (score & 255); // (1 + 2 + 4 + 8 + 16 + 75 + 80) = 186 & 255 -> let's verify total
]
