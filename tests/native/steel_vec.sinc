// EXPECT: 99
// Test: STEEL dynamic vector library operations

extern fn get_argv!();
extern fn getdents!();
extern fn exit!();
extern fn close!();
extern fn write!();
extern fn read!();
extern fn open!();
extern fn mmap!();

const VEC_DATA = 0;
const VEC_LEN  = 1;
const VEC_CAP  = 2;

fn vec_new!(arena, initial_cap) [
    cap = initial_cap;
    if (cap < 8) [
        cap = 8;
    ]
    data = arena_alloc_words!(arena, cap);
    vec = arena_alloc_words!(arena, 3);
    vec.VEC_DATA = data;
    vec.VEC_LEN  = 0;
    vec.VEC_CAP  = cap;
    ret vec;
]

fn vec_len(vec) [
    ret vec.VEC_LEN;
]

fn vec_get(vec, index) [
    data = vec.VEC_DATA;
    ret data@[index];
]

fn vec_set!(vec, index, value) [
    data = vec.VEC_DATA;
    data@[index] = value;
    ret 0;
]

fn vec_push!(arena, vec, value) [
    len = vec.VEC_LEN;
    cap = vec.VEC_CAP;
    data = vec.VEC_DATA;
    if (!(len < cap)) [
        new_cap = cap * 2;
        new_data = arena_alloc_words!(arena, new_cap);
        loop (i:10000000 = 0 .. len) [
            new_data@[i] = data@[i];
        ]
        vec.VEC_DATA = new_data;
        vec.VEC_CAP  = new_cap;
        data = new_data;
    ]
    data@[len] = value;
    vec.VEC_LEN = len + 1;
    ret len;
]

fn vec_pop!(vec) [
    len = vec.VEC_LEN;
    if (len == 0) [
        ret 0;
    ]
    new_len = len - 1;
    vec.VEC_LEN = new_len;
    data = vec.VEC_DATA;
    ret data@[new_len];
]

fn arena_init!(mem~, size) [
    arena = mem~;
    arena@[0] = arena + 24;
    arena@[1] = arena + 24;
    arena@[2] = arena + size;
    ret arena;
]

fn arena_alloc!(arena, bytes) [
    aligned_bytes = ((bytes + 7) >> 3) << 3;
    current_next = arena@[1];
    limit = arena@[2];
    if (current_next + aligned_bytes > limit) [ ret 0; ]
    arena@[1] = current_next + aligned_bytes;
    ret current_next;
]

fn arena_alloc_words!(arena, count) [
    ret arena_alloc!(arena, count * 8);
]

fn main!() [
    mem~ = mmap!(0, 65536, 3, 34, -1, 0);
    arena = arena_init!(mem~, 65536);
    
    // Start with small capacity 8, push 20 items to trigger dynamic resizing
    v = vec_new!(arena, 8);
    loop (i:100 = 0 .. 20) [
        vec_push!(arena, v, i * 5);
    ]
    
    // Pop last item (19 * 5 = 95)
    last = vec_pop!(v);
    
    // Check item at index 4 (4 * 5 = 20)
    idx4 = vec_get(v, 4);
    
    // last = 95, idx4 = 20, new len = 19.
    // 95 - 20 + 19 + 5 = 99
    ret (last - idx4) + vec_len(v) + 5;
]
