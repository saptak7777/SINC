// EXPECT: 30
// Test: Scalar loop multi-expression accumulation
fn compute_reduction(limit) [
    total = 0;
    loop (i:20 = 0 .. 20) [
        a = (i & 7) + 1;
        b = (i & 3) + 2;
        c = (i & 1) + 3;
        total = total + c * (a + b);
    ]
    ret (total & 255);
]

fn main() [
    res = compute_reduction(20);
    ret res;
]
