// EXPECT: 249
// Test: Nested branch with fallthrough conditions in a loop
fn main() [
    total = 0;
    loop (i:100 = 0 .. 100) [
        if (i < 50) [
            if ((i & 1) == 0) [
                total = total + 2;
            ] else [
                total = total + 1;
            ]
        ] else [
            if ((i & 3) == 0) [
                total = total + 5;
            ] else [
                total = total + 3;
            ]
        ]
    ]
    ret total;
]
