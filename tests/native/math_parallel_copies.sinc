// EXPECT: 7
// REQUIRE_INSN: and
// Test: Multiple independent derivations from the same source variable
fn helper(x) [
    sum = 0;
    loop (i:5 = 0 .. 1) [
        sum = sum + x;
    ]
    ret sum;
]

fn main() [
    seed = helper(42);
    x = 1 + (seed & 7);
    y = 2 + (seed & 3);
    ret (x + y + (seed & 1)) & 255;
]
