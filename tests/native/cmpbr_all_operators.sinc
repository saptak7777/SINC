// EXPECT: 255
// Test: All 4 comparison operators (==, !=, <, >) in CMPBR with constants and variables
fn main() [
    score = 0;
    x = 10;
    y = 20;

    if (x == 10) [ score = score + 1; ]
    if (x != 20) [ score = score + 2; ]
    if (x < 15)  [ score = score + 4; ]
    if (y > 15)  [ score = score + 8; ]

    // Register-register comparisons
    if (x < y)   [ score = score + 16; ]
    if (y > x)   [ score = score + 32; ]
    if (x != y)  [ score = score + 64; ]
    if (x == y)  [ score = score + 128; ] else [ score = score + 128; ]

    ret score & 255;
]
