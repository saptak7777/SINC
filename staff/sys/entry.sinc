// ==========================================
// staff/sys/entry.sinc
// SINC STAFF: Sovereign Project Build Orchestrator
// Pure Parasite: Leverages Mother's Lexer & compile_core!
// 100% Agnostic: Zero Target-Specific Branches
// ==========================================

fn staff_append_file!(path, trg_code_buf, len_ptr, scratch_buf) [
    fd = sys_open_read!(path);
    if (fd < 0) [
        sys_exit!(2);
    ]
    rb = sys_read!(fd, scratch_buf, 2097152);
    sys_close!(fd);
    if (rb < 64) [
        sys_exit!(20);
    ]
    w0 = scratch_buf@[0];
    hi = w0 >> 32;
    if ((hi & 4294902015) != 1409286145) [
        sys_exit!(20);
    ]
    f_len = w0 & 4294967295;
    if ((f_len + 64) > rb) [
        sys_exit!(20);
    ]
    cur = len_ptr@[0];
    dst = trg_code_buf + 64 + cur;
    src = scratch_buf + 64;
    loop (i:10000000 = 0 .. f_len) [
        dst@[i * 1] = src@[i * 1];
    ]
    dst@[f_len * 1] = 241;
    len_ptr@[0] = cur + f_len + 1;
    ret 0;
]

fn staff_str_gt(s1, s2) [
    loop (k:256 = 0 .. 256) [
        c1 = s1@[k * 1];
        c2 = s2@[k * 1];
        if ((c1 != c2) | (c1 == 0)) [
            ret c1 > c2;
        ]
    ]
    ret 0;
]

fn staff_stream_tray!(root_ptr, root_len, sub_word, sub_len, trg_code_buf, len_ptr, arena, is_sys, scratch_buf) [
    dir_path = arena_alloc_words!(arena, 40);
    loop (k:32 = 0 .. root_len) [
        dir_path@[k * 1] = root_ptr@[k * 1];
    ]
    dir_path@[root_len * 1] = 47;
    loop (k:8 = 0 .. sub_len) [
        dir_path@[(root_len + 1 + k) * 1] = (sub_word >> (k * 8)) & 255;
    ]
    dir_len = root_len + 1 + sub_len;
    dir_path@[dir_len * 1] = 0;

    fd = sys_open_read!(dir_path);
    if (fd < 0) [
        ret 0;
    ]
    dir_buf = arena_alloc_words!(arena, 8704);
    nbytes = 0;
    loop (gk:17 = 0 .. 17) [
        rb = sys_getdents!(fd, dir_buf + nbytes, 4096);
        if ((rb < 0) | ((nbytes + rb) > 65536)) [
            sys_exit!(5);
        ]
        if (rb == 0) [
            gk = 17;
        ] else [
            nbytes = nbytes + rb;
        ]
    ]
    sys_close!(fd);

    dir_path@[dir_len * 1] = 47;
    tray = arena_alloc_words!(arena, 128);
    count = 0;
    entry_ptr = 0;
    pos = 0;

    loop (dk:2730 = 0 .. 2730) [
        if (pos < nbytes) [
            reclen = dir_buf@[(pos + 16) * 1] | (dir_buf@[(pos + 17) * 1] << 8);
            if ((reclen < 24) | ((pos + reclen) > nbytes)) [
                sys_exit!(5);
            ]
            name_ptr = dir_buf + pos + 19;
            name_len = 0;
            loop (nk:256 = 0 .. 256) [
                if (name_ptr@[nk * 1] == 0) [
                    name_len = nk;
                    nk = 256;
                ]
            ]
            if (name_len > 4) [
                if ((name_ptr@[(name_len - 4) * 1] == 46) & (name_ptr@[(name_len - 3) * 1] == 116) & (name_ptr@[(name_len - 2) * 1] == 114) & (name_ptr@[(name_len - 1) * 1] == 103)) [
                    if ((is_sys == 1) & (name_len == 9) & (name_ptr@[0 * 1] == 101) & (name_ptr@[1 * 1] == 110) & (name_ptr@[2 * 1] == 116) & (name_ptr@[3 * 1] == 114) & (name_ptr@[4 * 1] == 121)) [
                        entry_ptr = name_ptr;
                    ] else [
                        if (count > 126) [
                            sys_exit!(5);
                        ]
                        tray@[count] = name_ptr;
                        count = count + 1;
                    ]
                ]
            ]
            pos = pos + reclen;
        ]
    ]

    if (pos != nbytes) [
        sys_exit!(5);
    ]

    loop (i:128 = 0 .. count) [
        loop (j:128 = (i + 1) .. count) [
            si = tray@[i];
            sj = tray@[j];
            if (staff_str_gt(si, sj) != 0) [
                tray@[i] = sj;
                tray@[j] = si;
            ]
        ]
    ]

    if (entry_ptr != 0) [
        tray@[count] = entry_ptr;
        count = count + 1;
    ]

    loop (s_idx:128 = 0 .. count) [
        item = tray@[s_idx];
        loop (k:256 = 0 .. 256) [
            ch = item@[k * 1];
            dir_path@[(dir_len + 1 + k) * 1] = ch;
            if (ch == 0) [
                k = 256;
            ]
        ]
        staff_append_file!(dir_path, trg_code_buf, len_ptr, scratch_buf);
    ]
    ret 0;
]

fn main!(argc, argv_ptr) [
    if (argc < 2) [
        sys_exit!(1);
    ]
    sys_mmap!(1073741824);
    arena = arena_init!(553648128, 1000000000);

    argv = get_argv!();
    manifest_path = argv@[1];
    out_target = 0;
    if (argc > 2) [
        out_target = argv@[2];
    ]

    m_fd = sys_open_read!(manifest_path);
    if (m_fd < 0) [
        sys_exit!(2);
    ]
    m_buf = arena_alloc_words!(arena, 2048);
    m_len = sys_read!(m_fd, m_buf, 16384);
    sys_close!(m_fd);
    if (m_len < 64) [
        sys_exit!(20);
    ]
    w0 = m_buf@[0];
    hi = w0 >> 32;
    if ((hi & 4294902015) != 1409286145) [
        sys_exit!(20);
    ]
    m_payload_len = w0 & 4294967295;
    if ((m_payload_len + 64) > m_len) [
        sys_exit!(20);
    ]
    m_pad_ptr = m_buf + 64 + m_payload_len;
    loop (pad:8 = 0 .. 8) [
        m_pad_ptr@[pad * 1] = 0;
    ]

    sym_table = arena_alloc_words!(arena, 16384);
    sym_count = arena_alloc_words!(arena, 1);
    sym_count@[0] = 0;

    lex_state = arena_alloc_words!(arena, 6);
    lex_state@[0] = m_buf + 64;
    lex_state@[1] = m_payload_len;
    tok = arena_alloc_words!(arena, 4);

    root_ptr = 0;
    root_len = 0;
    root_ascii = 0;
    driver_ptr = 0;

    trg_code_buf = arena_alloc_words!(arena, 524288);
    scratch_buf = arena_alloc_words!(arena, 262144);
    len_ptr = arena_alloc_words!(arena, 1);
    len_ptr@[0] = 0;

    loop (step:2000 = 0 .. 2000) [
        lexer_next_token!(lex_state, sym_table, 4096, sym_count, tok);
        tt = tok.TOK_TYPE;
        tv = tok.TOK_VAL;
        if (tt == 0) [
            step = 2000;
        ]

        if (tt == 9) [
            ptr = lex_state.LEX_TMP_PTR;
            len = lex_state.LEX_TMP_LEN;
            is_artifact = (len == 8) & (ptr@[0] == 3250501752074349338);
            is_deps = (len == 4) & ((ptr@[0] & 4294967295) == 740892189);
            is_driver = (len == 6) & ((ptr@[0] & 281474976710655) == 47408639781661);

            if (is_artifact != 0) [
                lexer_next_token!(lex_state, sym_table, 4096, sym_count, tok);
                root_ptr = lex_state.LEX_TMP_PTR;
                root_len = lex_state.LEX_TMP_LEN;
                root_ascii = arena_alloc_words!(arena, (root_len + 8) >> 3);
                os_trg_to_path!(root_ptr, root_len, root_ascii);
            ]

            if ((is_deps != 0) | (is_driver != 0)) [
                lexer_next_token!(lex_state, sym_table, 4096, sym_count, tok);
                if (tok.TOK_TYPE == 246) [
                    loop (dk:1000 = 0 .. 1000) [
                        lexer_next_token!(lex_state, sym_table, 4096, sym_count, tok);
                        if ((tok.TOK_TYPE == 247) | (tok.TOK_TYPE == 0)) [
                            dk = 1000;
                        ] else [
                            dep_ptr = lex_state.LEX_TMP_PTR;
                            loop (sk:100 = 0 .. 100) [
                                if (tok.TOK_TYPE == 250) [
                                    sk = 100;
                                ] else [
                                    lexer_next_token!(lex_state, sym_table, 4096, sym_count, tok);
                                ]
                            ]
                            cur_pos = lex_state.LEX_CURSOR - 1;
                            dep_len = cur_pos - (dep_ptr - (m_buf + 64));
                            is_own = 0;
                            if (root_len > 0) [
                                if (dep_ptr@[root_len * 1] == 115) [
                                    is_own = 1;
                                    loop (rk:32 = 0 .. root_len) [
                                        if (dep_ptr@[rk * 1] != root_ptr@[rk * 1]) [
                                            is_own = 0;
                                        ]
                                    ]
                                ]
                            ]
                            if (is_own != 0) [
                                sys_exit!(5);
                            ]
                            dep_ascii = arena_alloc_words!(arena, (dep_len + 8) >> 3);
                            os_trg_to_path!(dep_ptr, dep_len, dep_ascii);
                            if (is_deps != 0) [
                                staff_append_file!(dep_ascii, trg_code_buf, len_ptr, scratch_buf);
                            ] else [
                                driver_ptr = dep_ascii;
                            ]
                        ]
                    ]
                ]
            ]
        ]
    ]

    if (root_ascii == 0) [
        sys_exit!(3);
    ]

    staff_stream_tray!(root_ascii, root_len, 1635017060, 4, trg_code_buf, len_ptr, arena, 0, scratch_buf);
    staff_stream_tray!(root_ascii, root_len, 1701999984, 4, trg_code_buf, len_ptr, arena, 0, scratch_buf);
    staff_stream_tray!(root_ascii, root_len, 7567731, 3, trg_code_buf, len_ptr, arena, 1, scratch_buf);

    if (driver_ptr != 0) [
        staff_append_file!(driver_ptr, trg_code_buf, len_ptr, scratch_buf);
    ]

    total_len = len_ptr@[0];
    w0_hdr = total_len | (1 << 32) | (84 << 56);
    trg_code_buf@[0] = w0_hdr;
    loop (hk:7 = 1 .. 8) [
        trg_code_buf@[hk] = 0;
    ]
    pad_ptr = trg_code_buf + 64 + total_len;
    loop (pad:8 = 0 .. 8) [
        pad_ptr@[pad * 1] = 0;
    ]

    out_payload = compile_core!(trg_code_buf, 64 + total_len + 8, arena);

    if (out_target != 0) [
        out_fd = sys_open_write!(out_target);
        if (out_fd < 0) [
            sys_exit!(4);
        ]
        sys_write!(out_fd, out_payload@[2], 32);
        sys_write!(out_fd, out_payload@[0], out_payload@[1]);
        sys_close!(out_fd);
    ]

    sys_exit!(0);
]
