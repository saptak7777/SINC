// ==========================================
// staff/sys/entry.sinc
// SINC STAFF: Sovereign Project Build Orchestrator
// Pure Parasite: Leverages Mother's Lexer & compile_core!
// 100% Agnostic: Zero Target-Specific Branches
// ==========================================

fn staff_append_file!(path, src_buf, len_ptr) [
    fd = sys_open_read!(path);
    if (fd < 0) [
        sys_exit!(2);
    ]
    cur = len_ptr@[0];
    rb = sys_read!(fd, src_buf + cur, 2097152);
    sys_close!(fd);
    if (rb < 0) [
        sys_exit!(2);
    ]
    if (rb > 0) [
        src_buf@[(cur + rb) * 1] = 10; // '\n'
        len_ptr@[0] = cur + rb + 1;
    ]
    ret 0;
]

fn staff_str_gt(s1, s2) [
    loop (k:256 = 0 .. 256) [
        c1 = s1@[k * 1];
        c2 = s2@[k * 1];
        if ((c1 != c2) | (c1 == 0)) [
            ret c1 > c2;
        ]
    ]
    ret 0;
]

fn staff_stream_tray!(root_ptr, root_len, sub_word, sub_len, src_buf, len_ptr, arena, is_sys) [
    dir_path = arena_alloc_words!(arena, 40);
    loop (k:32 = 0 .. root_len) [
        dir_path@[k * 1] = root_ptr@[k * 1];
    ]
    dir_path@[root_len * 1] = 47; // '/'
    loop (k:8 = 0 .. sub_len) [
        dir_path@[(root_len + 1 + k) * 1] = (sub_word >> (k * 8)) & 255;
    ]
    dir_len = root_len + 1 + sub_len;
    dir_path@[dir_len * 1] = 0;

    fd = sys_open_read!(dir_path);
    if (fd < 0) [
        ret 0;
    ]
    dir_buf = arena_alloc_words!(arena, 8704);
    nbytes = 0;
    loop (gk:17 = 0 .. 17) [
        rb = sys_getdents!(fd, dir_buf + nbytes, 4096);
        if ((rb < 0) | ((nbytes + rb) > 65536)) [
            sys_exit!(5);
        ]
        if (rb == 0) [
            gk = 17;
        ] else [
            nbytes = nbytes + rb;
        ]
    ]
    sys_close!(fd);

    dir_path@[dir_len * 1] = 47; // '/'
    tray = arena_alloc_words!(arena, 128);
    count = 0;
    entry_ptr = 0;
    pos = 0;

    loop (dk:2730 = 0 .. 2730) [
        if (pos < nbytes) [
            reclen = dir_buf@[(pos + 16) * 1] | (dir_buf@[(pos + 17) * 1] << 8);
            if ((reclen < 24) | ((pos + reclen) > nbytes)) [
                sys_exit!(5);
            ]
            name_ptr = dir_buf + pos + 19;
            name_len = 0;
            loop (nk:256 = 0 .. 256) [
                if (name_ptr@[nk * 1] == 0) [
                    name_len = nk;
                    nk = 256;
                ]
            ]
            if (name_len > 5) [
                if ((name_ptr@[(name_len - 5) * 1] == 46) & (name_ptr@[(name_len - 4) * 1] == 115) & (name_ptr@[(name_len - 3) * 1] == 105) & (name_ptr@[(name_len - 2) * 1] == 110) & (name_ptr@[(name_len - 1) * 1] == 99)) [
                    if ((is_sys == 1) & (name_len == 10) & (name_ptr@[0 * 1] == 101) & (name_ptr@[1 * 1] == 110) & (name_ptr@[2 * 1] == 116) & (name_ptr@[3 * 1] == 114) & (name_ptr@[4 * 1] == 121)) [
                        entry_ptr = name_ptr;
                    ] else [
                        if (count > 126) [
                            sys_exit!(5);
                        ]
                        tray@[count] = name_ptr;
                        count = count + 1;
                    ]
                ]
            ]
            pos = pos + reclen;
        ]
    ]

    if (pos != nbytes) [
        sys_exit!(5);
    ]

    loop (i:128 = 0 .. count) [
        loop (j:128 = (i + 1) .. count) [
            si = tray@[i];
            sj = tray@[j];
            if (staff_str_gt(si, sj) != 0) [
                tray@[i] = sj;
                tray@[j] = si;
            ]
        ]
    ]

    if (entry_ptr != 0) [
        tray@[count] = entry_ptr;
        count = count + 1;
    ]

    loop (s_idx:128 = 0 .. count) [
        item = tray@[s_idx];
        loop (k:256 = 0 .. 256) [
            ch = item@[k * 1];
            dir_path@[(dir_len + 1 + k) * 1] = ch;
            if (ch == 0) [
                k = 256;
            ]
        ]
        staff_append_file!(dir_path, src_buf, len_ptr);
    ]
    ret 0;
]

fn main!(argc, argv_ptr) [
    if (argc < 2) [
        sys_exit!(1);
    ]
    sys_mmap!(1073741824);
    arena = arena_init!(553648128, 1000000000);

    argv = get_argv!();
    manifest_path = argv@[1];
    out_target = 0;
    if (argc > 2) [
        out_target = argv@[2];
    ]

    m_fd = sys_open_read!(manifest_path);
    if (m_fd < 0) [
        sys_exit!(2);
    ]
    m_buf = arena_alloc_words!(arena, 2048);
    m_len = sys_read!(m_fd, m_buf, 16384);
    sys_close!(m_fd);
    if (m_len < 1) [
        sys_exit!(2);
    ]

    // 1. Mother's UCTT Lexer Initialization
    sym_table = arena_alloc_words!(arena, 16384);
    sym_count = arena_alloc_words!(arena, 1);
    lut       = arena_alloc_words!(arena, 256);
    lexer_init!(arena, sym_table, 4096, sym_count, lut);

    kw_data   = arena_alloc_words!(arena, 6);
    sl        = arena_alloc_words!(arena, 2);
    intern_kw!(kw_data, sl, sym_table, 4096, sym_count, 8386654023577793121, 8); // 9: "artifact"
    intern_kw!(kw_data + 8, sl, sym_table, 4096, sym_count, 1936745828, 4);      // 10: "deps"
    intern_kw!(kw_data + 16, sl, sym_table, 4096, sym_count, 125780103885412, 6); // 11: "driver"

    lex_state = arena_alloc_words!(arena, 6);
    lex_state@[0] = m_buf;
    lex_state@[1] = m_len;
    tok = arena_alloc_words!(arena, 4);

    root_ptr = 0;
    root_len = 0;
    driver_ptr = 0;

    src_buf = arena_alloc_words!(arena, 2097152);
    len_ptr = arena_alloc_words!(arena, 1);
    len_ptr@[0] = 0;

    loop (step:2000 = 0 .. 2000) [
        lexer_next_token!(lex_state, sym_table, 4096, sym_count, tok, lut);
        tt = tok.TOK_TYPE;
        tv = tok.TOK_VAL;
        if (tt == 0) [
            step = 2000;
        ]

        if ((tt == 9) & (tv == 9)) [ // "artifact"
            lexer_next_token!(lex_state, sym_table, 4096, sym_count, tok, lut);
            root_ptr = lex_state.LEX_TMP_PTR;
            root_len = lex_state.LEX_TMP_LEN;
        ]

        if ((tt == 9) & ((tv == 10) | (tv == 11))) [ // "deps" or "driver"
            lexer_next_token!(lex_state, sym_table, 4096, sym_count, tok, lut);
            if (tok.TOK_TYPE == 13) [ // '['
                loop (dk:1000 = 0 .. 1000) [
                    lexer_next_token!(lex_state, sym_table, 4096, sym_count, tok, lut);
                    if ((tok.TOK_TYPE == 14) | (tok.TOK_TYPE == 0)) [ // ']' or EOF
                        dk = 1000;
                    ] else [
                        dep_ptr = lex_state.LEX_TMP_PTR;
                        loop (sk:100 = 0 .. 100) [
                            if (tok.TOK_TYPE == 22) [ // ';'
                                sk = 100;
                            ] else [
                                lexer_next_token!(lex_state, sym_table, 4096, sym_count, tok, lut);
                            ]
                        ]
                        m_buf@[(lex_state.LEX_CURSOR - 1) * 1] = 0;
                        is_own = 0;
                        if (root_len > 0) [
                            if (dep_ptr@[root_len * 1] == 47) [
                                is_own = 1;
                                loop (rk:32 = 0 .. root_len) [
                                    if (dep_ptr@[rk * 1] != root_ptr@[rk * 1]) [
                                        is_own = 0;
                                    ]
                                ]
                            ]
                        ]
                        if (is_own != 0) [
                            sys_exit!(5);
                        ]
                        if (tv == 10) [
                            staff_append_file!(dep_ptr, src_buf, len_ptr);
                        ] else [
                            driver_ptr = dep_ptr;
                        ]
                    ]
                ]
            ]
        ]
    ]

    if (root_ptr == 0) [
        sys_exit!(3);
    ]

    // Stream artifact's own Triad
    staff_stream_tray!(root_ptr, root_len, 1635017060, 4, src_buf, len_ptr, arena, 0); // data
    staff_stream_tray!(root_ptr, root_len, 1701999984, 4, src_buf, len_ptr, arena, 0); // pure
    staff_stream_tray!(root_ptr, root_len, 7567731, 3, src_buf, len_ptr, arena, 1);    // sys

    // If a host driver was declared (e.g. steel/sys/driver_linux.sinc), append it LAST
    if (driver_ptr != 0) [
        staff_append_file!(driver_ptr, src_buf, len_ptr);
    ]

    // In-memory compile via Mother
    out_payload = compile_core!(src_buf, len_ptr@[0], arena);

    if (out_target != 0) [
        out_fd = sys_open_write!(out_target);
        if (out_fd < 0) [
            sys_exit!(4);
        ]
        sys_write!(out_fd, out_payload@[2], 32);
        sys_write!(out_fd, out_payload@[0], out_payload@[1]);
        sys_close!(out_fd);
    ]

    sys_exit!(0);
]
