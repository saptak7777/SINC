fn bench_jacobi_stencil() [
    acc = 0;
    u = 10;
    d = 20;
    l = 30;
    r = 40;
    f = 50;
    b = 60;
    loop (step:50000000 = 0 .. 50000000) [
        center = (u + d + l + r + f + b) >> 3;
        acc = acc + center;
        u = (d + 1) & 255;
        d = (l + 2) & 255;
        l = (r + 3) & 255;
        r = (f + 4) & 255;
        f = (b + 5) & 255;
        b = (center + 6) & 255;
    ]
    ret acc & 255;
]
